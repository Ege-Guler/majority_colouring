   "source": [
    "using DotEnv\n",
    "DotEnv.config() \n",
    "\n",
    "using JuMP\n",
    "using Gurobi\n",
    "\n",
    "model = Model(Gurobi.Optimizer)\n",
    "\n",
    "# Simple test to confirm it works\n",
    "@variable(model, x >= 0)\n",
    "@objective(model, Min, x)\n",
    "optimize!(model)\n",
    "\n",
    "if termination_status(model) == OPTIMAL\n",
    "    println(\"Gurobi is licensed and running!\")\n",
    "end"
   ]
